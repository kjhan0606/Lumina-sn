+#!/usr/bin/env python3
+"""Fail-closed Stage 3.1 parity bench placeholder.
+
+The design forbids reconstructing eta from C1/C2.  This entry point records the
+missing frozen chi/eta capture without launching a model or substituting data.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--frozen", type=pathlib.Path)
+    parser.add_argument("--status-json", type=pathlib.Path)
+    args = parser.parse_args()
+    if args.frozen is None or not args.frozen.is_file():
+        report = {
+            "status": "UNRESOLVED-INPUT-1",
+            "reason": "authoritative parity59 total chi_nu and eta_nu capture is absent",
+            "c1_c2_eta_reconstruction": "FORBIDDEN",
+            "model_or_gpu_run": False,
+            "band_rows": 0,
+            "gamma_rows": 0,
+        }
+    else:
+        report = {
+            "status": "BLOCKED-KA1-GATE",
+            "reason": "capture exists, but the preregistered KA1 gate failed; bench execution is disabled",
+            "frozen_path": str(args.frozen),
+            "model_or_gpu_run": False,
+            "band_rows": 0,
+            "gamma_rows": 0,
+        }
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.status_json:
+        args.status_json.parent.mkdir(parents=True, exist_ok=True)
+        args.status_json.write_text(rendered)
+    print(rendered, end="")
+    return 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())


+void nlte_enforce_zero_abundance(NLTEConfig *nlte, AtomicData *atom,
+                                 PlasmaState *plasma, int n_shells) {
+    (void)plasma;
+    long excluded_ion_shells = 0, cleared_levels = 0, residual_nonzero = 0;
+    for (int e = 0; e < atom->n_elements; e++) {
+        int z = atom->element_Z[e];
+        for (int s = 0; s < n_shells; s++) {
+            if (atom->abundances[e * n_shells + s] != 0.0) continue;
+            for (int ip = atom->elem_ion_offset[e]; ip < atom->elem_ion_offset[e + 1]; ip++) {
+                size_t at = (size_t)ip * n_shells + s;
+                if (atom->ion_number_density[at] != 0.0) residual_nonzero++;
+                atom->ion_number_density[at] = 0.0;
+            }
+            for (int ii = 0; ii < nlte->n_nlte_ions; ii++) {
+                if (nlte->nlte_Z[ii] != z) continue;
+                excluded_ion_shells++;
+                for (int l = nlte->nlte_ion_level_offset[ii];
+                     l < nlte->nlte_ion_level_offset[ii + 1]; l++) {
+                    size_t at = (size_t)l * n_shells + s;
+                    if (nlte->nlte_level_populations[at] != 0.0) residual_nonzero++;
+                    nlte->nlte_level_populations[at] = 0.0;
+                    cleared_levels++;
+                }
+            }
+        }
+    }
+    printf("[ABUNDANCE-ZERO-NLTE] excluded_ion_shell_slots=%ld cleared_level_cells=%ld residual_nonzero_before_clear=%ld policy=EXACT_ZERO\n",
+           excluded_ion_shells, cleared_levels, residual_nonzero);
+}

+                char *end = NULL;
+                if (*p != ',') {
+                    fprintf(stderr, "ERROR: %s Z=%d ends before shell %d/%d\n",
+                            path, z_csv, s, n_shells);
+                    fclose(fp);
+                    return -1;
+                }
+                p++;
+                atom->abundances[eidx * n_shells + s] = strtod(p, &end);
+                if (end == p || !isfinite(atom->abundances[eidx * n_shells + s])) {
+                    fprintf(stderr, "ERROR: %s Z=%d invalid shell %d\n", path, z_csv, s);
+                    fclose(fp);
+                    return -1;
+                }
+                p = end;
             }
             elem_idx++;
         }
         fclose(fp);
+    } else {
+        fprintf(stderr, "ERROR: Cannot open %s\n", path);
+        return -1;
+    }
+
+    /* Current-epoch radioactive subsets.  Elemental abundance remains the
+     * opacity/ionization total; these arrays are only decay-chain membership. */
+    atom->isotope_ni56 = (double *)calloc((size_t)n_shells, sizeof(double));
+    atom->isotope_co56 = (double *)calloc((size_t)n_shells, sizeof(double));
+    atom->isotope_fe56 = (double *)calloc((size_t)n_shells, sizeof(double));
+    snprintf(path, sizeof(path), "%s/isotopes.csv", ref_dir);
+    fp = fopen(path, "r");
+    if (fp) {
+        char line[8192];
+        int seen = 0;
+        if (!fgets(line, sizeof(line), fp)) {
+            fprintf(stderr, "ERROR: empty %s\n", path);
+            fclose(fp);
+            return -1;
+        }
+        while (fgets(line, sizeof(line), fp)) {
+            char name[16]; int z = 0, a = 0, used = 0;
+            if (sscanf(line, "%15[^,],%d,%d,%n", name, &z, &a, &used) < 3) {
+                fprintf(stderr, "ERROR: malformed row in %s\n", path);
+                fclose(fp);
+                return -1;
+            }
+            double *dest = NULL;
+            if (!strcmp(name, "Ni56") && z == 28 && a == 56) dest = atom->isotope_ni56;
+            if (!strcmp(name, "Co56") && z == 27 && a == 56) dest = atom->isotope_co56;
+            if (!strcmp(name, "Fe56") && z == 26 && a == 56) dest = atom->isotope_fe56;
+            if (!dest) {
+                fprintf(stderr, "ERROR: unexpected isotope identity %s,%d,%d in %s\n",
+                        name, z, a, path);
+                fclose(fp);
+                return -1;
+            }
+            char *p = line + used;
+            for (int s = 0; s < n_shells; s++) {
+                char *end = NULL;
+                dest[s] = strtod(p, &end);
+                if (end == p || !isfinite(dest[s]) || dest[s] < 0.0) {
+                    fprintf(stderr, "ERROR: %s %s invalid/missing shell %d\n", path, name, s);
+                    fclose(fp);
+                    return -1;
+                }
+                p = end;
+                if (s + 1 < n_shells) {
+                    if (*p != ',') { fclose(fp); return -1; }
+                    p++;
+                }
+            }
+            seen++;
+        }
+        fclose(fp);
+        if (seen != 3) {
+            fprintf(stderr, "ERROR: %s has %d isotope rows, expected 3\n", path, seen);
+            return -1;
+        }
+        atom->isotopes_loaded = 1;
     }
 

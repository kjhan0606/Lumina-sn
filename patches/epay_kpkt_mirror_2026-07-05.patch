+            double dr2 = geo->r_outer[s2] - geo->r_inner[s2];
+            acc_tau += ne2 * CM_SIGMA_T * (dr2 > 0.0 ? dr2 : 0.0);
+            epay_tau_arr[s2] = acc_tau;
+        }
+    }

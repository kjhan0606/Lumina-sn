     if(opacity && opacity->tau_sobolev){
         for(int line=0;line<atom->n_lines;line++) if(atom->line_atomic_number[line]==Z){
-            double tau=fabs(opacity->tau_sobolev[(size_t)line*plasma->n_shells+shell]);

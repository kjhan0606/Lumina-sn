--- /dev/null
+++ b/scripts/stage32_rung1_check.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Fail-closed reader and KA-3.2.3 judge for LCMFR101."""
+from __future__ import annotations
+import argparse, hashlib, json, struct
+from pathlib import Path
+import numpy as np
+
+MAGIC=b"LCMFR101"; ENDIAN=0x01020304; VERSION=1
+CONTRACT_ITERATION=10; HEADER=struct.Struct("<8sIIQQIIIIQddII")
+ROW=np.dtype([("line","<u4"),("shell","<u4"),("bin","<u4"),("reserved0","<u4"),
+              ("lambda_A","<f8"),("tau","<f8"),("beta","<f8"),
+              ("lambda_star","<f8"),("eps_l","<f8"),("rho_local","<f8"),
+              ("eta_energy","<f8"),("reserved1","<u4"),("disposition","<u4")])
+NAMES=("legacy_source","thick_exempt","rate_shape_replaced","scalar_rescaled")
+class R1Error(ValueError): pass
+
+def read_check(path: Path, expected_iteration: int=CONTRACT_ITERATION):
+    path=Path(path); raw=path.read_bytes()
+    if len(raw)<HEADER.size: raise R1Error("truncated header")
+    vals=HEADER.unpack_from(raw)
+    magic,endian,version,it,gen,ns,nb,nl,reserved,nrows,llo,lhi,rowbytes,flags=vals
+    if (magic,endian,version)!=(MAGIC,ENDIAN,VERSION): raise R1Error("schema identity mismatch")
+    if reserved or flags or rowbytes!=ROW.itemsize or len(raw)!=HEADER.size+nrows*rowbytes:
+        raise R1Error("header/length mismatch")
+    if it!=expected_iteration or gen!=it: raise R1Error("iteration/field_generation mismatch")
+    if not (ns>0 and nb>0 and nl>0 and (llo,lhi)==(600.0,3000.0)):
+        raise R1Error("invalid dimensions/window")
+    rows=np.frombuffer(raw,dtype=ROW,count=nrows,offset=HEADER.size).copy()
+    finite=("lambda_A","tau","beta","lambda_star","eps_l","rho_local","eta_energy")
+    if any(not np.isfinite(rows[n]).all() for n in finite): raise R1Error("nonfinite row")
+    if (np.any(rows["tau"]<=0) or np.any(rows["beta"]<=0) or np.any(rows["beta"]>1)
+        or np.any(rows["lambda_star"]<0) or np.any(rows["lambda_star"]>=1)
+        or np.any(rows["eps_l"]<0) or np.any(rows["eps_l"]>1)
+        or np.any(rows["rho_local"]<0) or np.any(rows["rho_local"]>=1)
+        or np.any(rows["eta_energy"]<0) or np.any(rows["disposition"]>3)):
+        raise R1Error("row outside exact mathematical domain")
+    beta_ref=-np.expm1(-rows["tau"])/rows["tau"]
+    if not np.allclose(rows["beta"],beta_ref,rtol=1e-12,atol=0):
+        raise R1Error("KA-3.2.3 FAIL: Sobolev beta differs from analytic oracle")
+    if not np.array_equal(rows["lambda_star"],1.0-rows["beta"]):
+        raise R1Error("Lambda_star identity failure")
+    if not np.array_equal(rows["rho_local"],(1.0-rows["eps_l"])*rows["lambda_star"]):
+        raise R1Error("rho_local identity failure")
+    # KA-3.2.3 closed-form S,Jbar, independently using beta_ref.
+    jext=0.37; B=1.41; eps=rows["eps_l"]
+    D=eps+rows["beta"]-eps*rows["beta"]
+    Dr=eps+beta_ref-eps*beta_ref
+    S=((1-eps)*rows["beta"]*jext+eps*B)/D
+    Sr=((1-eps)*beta_ref*jext+eps*B)/Dr
+    J=(1-rows["beta"])*S+rows["beta"]*jext
+    Jr=(1-beta_ref)*Sr+beta_ref*jext
+    scaleS=np.maximum(np.abs(Sr),np.finfo(float).tiny)
+    scaleJ=np.maximum(np.abs(Jr),np.finfo(float).tiny)
+    if np.max(np.abs(S-Sr)/scaleS)>1e-12 or np.max(np.abs(J-Jr)/scaleJ)>1e-12:
+        raise R1Error("KA-3.2.3 FAIL: analytic S/Jbar relative error > 1e-12")
+    mf=json.loads(Path(str(path)+".manifest.json").read_text())
+    if mf.get("schema")!="LCMFR101-v1" or mf.get("sha256")!=hashlib.sha256(raw).hexdigest():
+        raise R1Error("manifest schema/SHA mismatch")
+    if mf.get("iteration")!=it or mf.get("field_generation")!=gen or mf.get("rows")!=nrows:
+        raise R1Error("manifest generation/count mismatch")
+    if mf.get("output_route")!="post-EPAY-read-only-sideband" or mf.get("output_discarded_rows")!=0:
+        raise R1Error("hard gate: output survival is not proved")
+    counts={name:int(np.count_nonzero(rows["disposition"]==i)) for i,name in enumerate(NAMES)}
+    energies={name:float(rows["eta_energy"][rows["disposition"]==i].sum(dtype=np.longdouble))
+              for i,name in enumerate(NAMES)}
+    if mf.get("disposition_row_counts")!=counts: raise R1Error("disposition count census mismatch")
+    me=mf.get("disposition_energy",{})
+    for name in NAMES:
+        if not np.isclose(me.get(name,np.nan),energies[name],rtol=2e-15,atol=0):
+            raise R1Error(f"disposition energy census mismatch: {name}")
+    if counts["rate_shape_replaced"]<=0 or not (energies["rate_shape_replaced"]>0):
+        raise R1Error("hard gate: rate_shape_replaced lacks count/energy evidence")
+    thick=rows["tau"]>=100.0
+    thick_energy=float(rows["eta_energy"][thick].sum(dtype=np.longdouble))
+    in_range=thick & (rows["rho_local"]>=0.99) & (rows["rho_local"]<1.0)
+    range_energy=float(rows["eta_energy"][in_range].sum(dtype=np.longdouble))
+    frac=range_energy/thick_energy if thick_energy else None
+    median=None
+    if thick_energy:
+        order=np.argsort(rows["rho_local"][thick])
+        rv=rows["rho_local"][thick][order]; ew=rows["eta_energy"][thick][order]
+        median=float(rv[np.searchsorted(np.cumsum(ew,dtype=np.longdouble),thick_energy/2)])
+    prediction=(frac is not None and frac>=0.9 and median is not None and 0.99<=median<1.0)
+    return {"rows":int(nrows),"sha256":mf["sha256"],"disposition_counts":counts,
+            "disposition_energy":energies,"KA-3.2.3":"PASS",
+            "rho_preregister_energy_fraction":frac,"rho_energy_weighted_median":median,
+            "rho_preregister_status":"MATCH" if prediction else "OUTSIDE_DISCOVERY"}
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument("path",type=Path);ap.add_argument("--expected-iteration",type=int,default=10)
+    a=ap.parse_args()
+    try: print(json.dumps(read_check(a.path,a.expected_iteration),indent=2,sort_keys=True));return 0
+    except Exception as e: print(f"FAIL: {e}");return 1
+if __name__=="__main__": raise SystemExit(main())

+#!/usr/bin/env python3
+"""Model-free Rung-1 positive controls and mandatory beta-defect control."""
+from __future__ import annotations
+import json, os, shutil, subprocess, tempfile
+from pathlib import Path
+from stage32_rung1_check import R1Error, read_check
+
+def run(exe: Path,out: Path,extra=None):
+    env=os.environ.copy();env.update(extra or {})
+    return subprocess.run([str(exe),str(out)],env=env,text=True,capture_output=True)
+
+def main():
+    root=Path(__file__).resolve().parents[1];exe=root/"selftest_stage32_rung1_writer"
+    work=Path(tempfile.mkdtemp(prefix="stage32_r1_",dir="/tmp"));result={}
+    try:
+        good=work/"good.bin";p=run(exe,good)
+        if p.returncode: raise RuntimeError(p.stderr)
+        result["positive"]=read_check(good)
+        # Required negative control: an intentionally wrong beta must make
+        # KA-3.2.3 fail, not merely change a checksum.
+        bad=work/"beta_defect.bin";p=run(exe,bad,{"S32_SEED_BETA_DEFECT":"1"})
+        if p.returncode: raise RuntimeError("defect writer failed before KA judge")
+        try: read_check(bad);raise RuntimeError("beta defect was accepted")
+        except R1Error as e:
+            if "KA-3.2.3 FAIL" not in str(e): raise
+            result["beta_defect_negative_control"]=str(e)
+        # R-N4-style generation mismatch.
+        g11=work/"g11.bin";p=run(exe,g11,{"S32_FIXTURE_ITER":"11"})
+        if p.returncode: raise RuntimeError(p.stderr)
+        try: read_check(g11);raise RuntimeError("generation mismatch accepted")
+        except R1Error as e: result["generation_mismatch_refused"]=str(e)
+        # Payload tamper against an unchanged sidecar.
+        tamper=work/"tamper.bin";shutil.copy(good,tamper)
+        shutil.copy(Path(str(good)+".manifest.json"),Path(str(tamper)+".manifest.json"))
+        raw=bytearray(tamper.read_bytes());raw[-9]^=1;tamper.write_bytes(raw)
+        try: read_check(tamper);raise RuntimeError("tamper accepted")
+        except R1Error as e: result["payload_tamper_refused"]=str(e)
+        # Writer must refuse overwriting an existing generation.
+        p=run(exe,good)
+        if p.returncode==0: raise RuntimeError("generation overwrite accepted")
+        result["generation_overwrite_refused"]=p.stderr.strip()
+        result["verdict"]="PASS";print(json.dumps(result,indent=2,sort_keys=True));return 0
+    except Exception as e:
+        result["verdict"]=f"FAIL: {e}";print(json.dumps(result,indent=2,sort_keys=True));return 1
+    finally: shutil.rmtree(work,ignore_errors=True)
+if __name__=="__main__": raise SystemExit(main())

+    stream = fopen(path, "wb"); if (stream == NULL) { status = LCMF_EIO; goto done; }
+    (void)fprintf(stream, "# nr=%zu nmu=%zu source_iterations=%zu source_residual=%.17g transport_residual=%.17g energy_closure=%.17g Lthermal=%.17g Lescape=%.17g Labsorbed=%.17g clamp=%llu solution_negative_excess=%llu sign_uncertain=%llu nonfinite=%llu\n",
+                  nr, nmu, result.source_iterations, result.source_resid_linf,

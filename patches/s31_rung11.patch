+    if (stream != NULL && fclose(stream) != 0 && status == LCMF_OK) status = LCMF_EIO;
+    lumina_cmf_result_free(&escape_result); lumina_cmf_result_free(&result);
+    free(eta_converged); free(chi_coherent); free(eta_fixed); free(chi); free(edge);
+    return status;
+}

# LUMINA-SN parity-campaign BASELINE gates — promoted 2026-07-28 (parity36-38).
#
# Source this from a launcher BEFORE `bash scripts/run_coevolve_s01.sh`:
#     . scripts/parity_baseline.env
# Every gate here is exported explicitly, so it wins over the ${VAR-default}
# fallbacks in run_coevolve_s01.sh. That file's defaults are deliberately NOT
# changed: ~250 historical launchers (DDC15, SN 2002bo, the fix*/sbatch_* series)
# route through it and were tuned on top of the old behaviour. Flipping a global
# default would silently re-baseline all of them — exactly the accident recorded
# in project_268 ("removing the bug by ANY mechanism injects the missing opacity
# uncompensated"). Promotion here means "new parity runs opt in explicitly".

# --- silicon is NLTE like every other element -------------------------------
# Was 14 (silicon kept nebular tau). Evidence (parity36a vs 36b/37/38, single
# effective variable, controls bit-identical):
#   * emergent L over the CMFGEN-truth overlap window (2500-19995 A):
#       0.790 x truth  ->  1.014 x truth
#   * internal J field vs CMFGEN truth at s8: 3 of 4 bands moved toward truth
#     (1300-2000 0.436->0.330, 2000-3000 0.692->0.610, 3000-4000 0.667->0.573);
#     1000-1300 moved away (0.901->1.547) and is left to front-B / front-C.
#   * the stated reason for the skip -- "NLTE collapses tau many orders below the
#     Saha-Boltzmann nebular estimate for dominant ions like Si II" -- was not
#     reproduced: nebular-thick lines stayed thick in every shell group measured.
export LUMINA_NLTE_SKIP_Z=

# --- no LTE floor on sub-resolution NLTE levels ------------------------------
# Was 1. The floor replaced every level with x[i] <= xmax*1e-12 by its LTE@Te
# value relative to the ion ground (cuda.cu:1490-1514). Raising an upper level to
# LTE while its solved lower level sits 3-4 decades below LTE drives
# (g_u n_l)/(g_l n_u) toward 1, i.e. S_l/B = 1e3..1.8e5. Measured at s45/s49:
# such mixed pairs carried 99.8-99.9% of ALL line emission in 1000-1300 A, while
# pairs with BOTH levels solved carried 0.0%. Turning it off:
#   * Si emission in that band fell 1.1e5x (s45) / 8.5e4x (s49) -- robust to
#     trimming: sum-minus-top-3 1.6e5x, median 2.6e7x, 90th pct 1.1e4x
#   * FORMAL-CONS 34.89 -> 4.37
#   * NO measurable cost on ions that are actually present: zero levels lost
#     (n_k<=0 count 0 in both arms once absent ions are excluded), b_k>1e4 count
#     282 -> 295. The only adverse indicator is the b_k p99 tail, 7.3 -> 152.7,
#     carried by levels holding ~1e-18 of their ion (total 1.3e-4) -- a label, not
#     mass, and confined to s25-39 with none in the photosphere.
# NOTE the floor's damage lives BELOW 2500 A, so the published CMFGEN spectrum
# cannot see it (1.017 vs 1.014 x truth). The case for removing it rests on the
# internal J truth, on the emission attribution above, and on the principle that a
# clamp must not inject mass into levels the solver reported as empty.
export LUMINA_NLTE_LTE_FLOOR=0

# --- observers that every judgment run should carry --------------------------
export LUMINA_JBAR_DUMP=1
export LUMINA_JBAR_DUMP_IONS=14:1,14:2
export LUMINA_CMF_FINE_LINEDUMP=1
export LUMINA_CMF_FINE_LINEDUMP_SHELL=8,45,49

# Deliberately NOT promoted:
#   LUMINA_SL_WRITE_SKIPZ  — structurally wrong (nebular tau x NLTE S_l breaks the
#                            pairing identity; FORMAL-CONS 5973). Keep it unset.
#   LUMINA_CMF_LINERES_CONSUME — mode-2 differenced estimator, rejected on
#                            arithmetic (needs beta-level precision, gets ~10%).

# ★생산 채택 (2026-07-31 user 승인): Wave 1 수리 게이트 3종 기본 ON + D-4 채널 영구 OFF
# 근거: 이중계상(D-4)·stim-recomb 부재(D-3)·neutral bf skip·spin 비일관(B18-a) = 증명된 버그.
# 새 어긋남 지도 기준선 = parity60. 역방향 축(s0 철족·s20 S)은 Wave 3(D-5) 조준점.
export LUMINA_FIX_BF_STIM_RECOMB=1 LUMINA_FIX_BF_NEUTRAL=1 LUMINA_FIX_BF_ETA_SPINGATE=1
export LUMINA_MA_LINE_DESTRUCT=0

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cat RESUME.md 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "cat RESUME.md 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat RESUME.md 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}

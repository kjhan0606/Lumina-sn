# Capture-only additions. The producer selector is the current-tree equivalent
# of the requested expected-iter=10 contract; the checker re-enforces 10.
export LUMINA_CMF_FROZEN_CHIETA_DUMP="${RUN_DIR:?RUN_DIR must be set}/chieta_iter10"
export LUMINA_CMF_FROZEN_CHIETA_ITER="$CHIETA_EXPECTED_ITER"
export LUMINA_EMISS_AB_DUMP=${RUN_DIR}/emiss_ab_iter10
export LUMINA_FLUOR_MATRIX_DUMP=${RUN_DIR}/fluor_matrix_iter10

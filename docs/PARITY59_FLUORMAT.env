# parity59 authoritative RESOLVED CONFIG replay for the chi/eta capture job.
# Source only after RUN_DIR has been set to the job-private GPFS directory.
# Base block: 120/120 variables printed by the parity59 binary.

# Operational metadata (intentionally not exported, so it is absent from the
# binary's RESOLVED CONFIG and RUN FOOTER).
CHIETA_EXPECTED_ITER=10
CHIETA_ORACLE_CELLS=0,8,20

# Non-reported OpenMP placement from the authoritative parity59 launcher.
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# parity59 RESOLVED CONFIG, sorted by variable name.
export LUMINA_ALPHA_SPINGATE=1
export LUMINA_ARTIS_PARITY=1
export LUMINA_BF_OPACITY=1
export LUMINA_BF_RATE_POPS=1
export LUMINA_BIN=lumina_cuda.withParityAG
export LUMINA_C1_BIN_DUMP=1
